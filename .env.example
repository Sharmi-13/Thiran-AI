# Thiran AI — environment configuration template
# Copy this file to ".env" and adjust values. ".env" is gitignored.

# AI backend: "mock" (no API key required) or "gemini" (used later).
AI_PROVIDER=gemini

# Gemini API key — leave blank until a key is available.
GEMINI_API_KEY=

# Gemini model id used by the agents.
GEMINI_MODEL=gemini-3.8-flash

# SQLite database location (relative to the project root).
DB_PATH=data/thiran.db

# Default UI language: english | tamil | tanglish
DEFAULT_LANGUAGE=english
